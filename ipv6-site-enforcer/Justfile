# IPv6-Site-Enforcer — Deployment Automation.
#
# This justfile provides the operational recipes for managing the 
# IPv6 transition gateway within a Kubernetes cluster.

# LIST: Displays available deployment tasks.
default:
    @just --list

# DEPLOY: Atomically applies the full manifest suite to the cluster.
# Sequence: Namespace -> Config -> Deployment -> Service.
deploy:
    @echo "Provisioning IPv6 transition gateway..."
    kubectl apply -f manifests/namespace.yaml
    kubectl apply -f manifests/configmap.yaml
    kubectl apply -f manifests/deployment.yaml
    kubectl apply -f manifests/service.yaml
    @just status

# VERIFICATION: Executes a DNS64 synthesis test.
# Ensures that the gateway correctly generates AAAA records for 
# legacy IPv4-only domains.
test-dns64 DOMAIN="example.com":
    @echo "Verifying DNS64 synthesis for {{DOMAIN}}..."
    kubectl -n ipv6-enforcer exec deployment/ipv6-site-enforcer -c unbound-dns64 -- \
        dig AAAA {{DOMAIN}} @127.0.0.1

# CLEANUP: Removes all gateway resources from the cluster.
undeploy:
    @echo "De-provisioning IPv6 transition gateway..."
    kubectl delete -f manifests/ --ignore-not-found=true
