# SPDX-License-Identifier: MPL-2.0
# IPv6-Only Tools Container
# Based on Chainguard Wolfi for minimal attack surface

# Build stage
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

# Install Rust and build dependencies. On the Chainguard wolfi apk repo the
# `cargo` binary ships inside the `rust` package (there is no standalone
# `cargo` package — `apk add cargo` fails with "no such package"), so it is
# not listed separately here.
RUN apk add --no-cache \
    rust \
    build-base

WORKDIR /build

# Copy source files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY src/ ./src/

# Build release binary
RUN cargo build --release

# Runtime stage
FROM cgr.dev/chainguard/wolfi-base:latest

LABEL maintainer="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"
LABEL description="IPv6-only networking tools written in Rust"
LABEL org.opencontainers.image.source="https://github.com/hyperpolymath/ipv6-only"
LABEL org.opencontainers.image.description="Comprehensive IPv6-only networking toolkit"
LABEL org.opencontainers.image.licenses="MPL-2.0"
LABEL version="0.1.0"

# Install runtime dependencies
RUN apk add --no-cache \
    iproute2 \
    iputils \
    bind-tools \
    tcpdump \
    curl \
    ca-certificates \
    bash

# Create non-root user
RUN adduser -D -u 1000 ipv6tools
USER ipv6tools

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/ipv6 /usr/local/bin/ipv6

# Copy shell scripts
COPY --chown=ipv6tools:ipv6tools scripts/*.sh /app/scripts/
COPY --chown=ipv6tools:ipv6tools src/scripts/*.sh /app/src/scripts/

# Create directories for data
RUN mkdir -p /app/data /app/config

# Set environment variables
ENV PATH="/usr/local/bin:${PATH}"

# Default command
ENTRYPOINT ["/usr/local/bin/ipv6"]
CMD ["--help"]

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/ipv6 --version || exit 1

# Volume for persistent data
VOLUME ["/app/data", "/app/config"]
