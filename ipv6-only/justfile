# SPDX-License-Identifier: AGPL-3.0-or-later
# IPv6-Only Tools - RSR-Compliant Justfile
# Task automation for Rust-based IPv6 networking toolkit
#
# RSR Policy Compliance:
#   Allowed: Rust, Deno (JS runtime), ReScript, Bash/POSIX Shell, Nickel
#   Banned: TypeScript, Node.js, npm, Go, Python (except SaltStack)

# Project metadata
project := "ipv6-only"
version := "0.1.0"

# Default recipe - show help
default:
    @just --list --unsorted

# ============================================================================
# BUILD & COMPILE (Rust)
# ============================================================================

# Build all Rust crates (debug)
build:
    @echo "Building Rust crates..."
    cargo build

# Build all Rust crates (release)
build-release:
    @echo "Building Rust crates (release)..."
    cargo build --release

# Build with all features
build-all-features:
    cargo build --all-features

# Watch and rebuild on changes
watch:
    cargo watch -x build

# Clean build artifacts (reversible: just rebuild)
clean:
    @echo "Cleaning build artifacts..."
    cargo clean
    rm -rf bin/ build/ dist/

# ============================================================================
# TEST & QUALITY (Rust)
# ============================================================================

# Run all tests
test:
    @echo "Running all tests..."
    cargo test

# Run tests with verbose output
test-verbose:
    cargo test -- --nocapture

# Run tests for specific crate
test-crate CRATE:
    cargo test -p {{ CRATE }}

# Run tests with coverage (requires cargo-llvm-cov)
test-coverage:
    cargo llvm-cov --html
    @echo "Coverage report: target/llvm-cov/html/index.html"

# ============================================================================
# LINT & FORMAT (Rust)
# ============================================================================

# Format all code
fmt:
    @echo "Formatting code..."
    cargo fmt

# Check formatting without changes
fmt-check:
    cargo fmt -- --check

# Run clippy linter
lint:
    @echo "Running clippy..."
    cargo clippy -- -D warnings

# Run all quality checks
check: fmt-check lint
    @echo "✅ All quality checks passed"

# ============================================================================
# DOCUMENTATION
# ============================================================================

# Generate Rust documentation
docs:
    @echo "Generating documentation..."
    cargo doc --no-deps

# Open documentation in browser
docs-open: docs
    cargo doc --no-deps --open

# Build AsciiDoc documentation
docs-asciidoc:
    @echo "Building AsciiDoc documentation..."
    asciidoctor docs/*.adoc -D build/docs/ 2>/dev/null || echo "Install asciidoctor for doc generation"

# ============================================================================
# NICKEL CONFIGURATION
# ============================================================================

# Validate Nickel configuration
config-validate:
    @echo "Validating Nickel configuration..."
    nickel typecheck config/ipv6-tools.ncl

# Export configuration to JSON
config-export:
    @echo "Exporting configuration..."
    mkdir -p config/generated
    nickel export < config/ipv6-tools.ncl > config/generated/config.json

# Export configuration to YAML
config-export-yaml:
    nickel export --format yaml < config/ipv6-tools.ncl > config/generated/config.yaml

# Query configuration field
config-query FIELD:
    nickel query config/ipv6-tools.ncl {{ FIELD }}

# ============================================================================
# CLI TOOL OPERATIONS
# ============================================================================

# Run the IPv6 CLI tool
run *ARGS:
    cargo run -- {{ ARGS }}

# Validate IPv6 address
validate *ADDRS:
    cargo run -- validate {{ ADDRS }}

# Calculate subnet information
calc NETWORK *FLAGS:
    cargo run -- calc {{ NETWORK }} {{ FLAGS }}

# Generate IPv6 address
generate TYPE *FLAGS:
    cargo run -- generate {{ TYPE }} {{ FLAGS }}

# Convert address format
convert ADDR *FLAGS:
    cargo run -- convert {{ ADDR }} {{ FLAGS }}

# Analyze address
analyze ADDR:
    cargo run -- analyze {{ ADDR }}

# ============================================================================
# HURRICANE ELECTRIC TUNNEL
# ============================================================================

# Setup HE tunnel
he-setup TUNNEL_ID USER PASS:
    @echo "Setting up HE tunnel {{ TUNNEL_ID }}..."
    ./scripts/he-tunnel-setup.sh {{ TUNNEL_ID }} {{ USER }} {{ PASS }}

# Update HE tunnel endpoint
he-update TUNNEL_ID:
    ./scripts/he-update-endpoint.sh {{ TUNNEL_ID }}

# Check HE tunnel status
he-status:
    ./scripts/he-check-status.sh

# Check HE certification progress
he-cert USER:
    ./scripts/he-cert-check.sh {{ USER }}

# ============================================================================
# NETWORK DIAGNOSTICS
# ============================================================================

# Run IPv6 diagnostics
diag:
    @echo "Running IPv6 diagnostics..."
    sudo ./src/scripts/ipv6-diag.sh

# Quick diagnostics
diag-quick:
    ./src/scripts/ipv6-diag.sh --quick

# Show IPv6 configuration
net-show:
    sudo ./src/scripts/ipv6-config.sh show

# Check IPv6 connectivity
check-ipv6:
    @echo "Checking IPv6 connectivity..."
    ping6 -c 1 2001:4860:4860::8888 && echo "✅ IPv6 works" || echo "❌ IPv6 not available"

# ============================================================================
# CONTAINERS (Podman/nerdctl)
# ============================================================================

# Build container image
container-build TAG="latest":
    @echo "Building container image..."
    podman build -f Containerfile -t {{ project }}:{{ TAG }} .

# Run container interactively
container-run TAG="latest":
    podman run -it --rm --name {{ project }} {{ project }}:{{ TAG }}

# Run container with IPv6 networking
container-run-ipv6 TAG="latest":
    podman run -it --rm --name {{ project }} \
        --network slirp4netns:enable_ipv6=true \
        {{ project }}:{{ TAG }}

# Push container to registry
container-push REGISTRY TAG="latest":
    podman tag {{ project }}:{{ TAG }} {{ REGISTRY }}/{{ project }}:{{ TAG }}
    podman push {{ REGISTRY }}/{{ project }}:{{ TAG }}

# Scan container for vulnerabilities
container-scan TAG="latest":
    podman run --rm aquasec/trivy image {{ project }}:{{ TAG }}

# Clean containers and images
container-clean:
    podman container prune -f
    podman image prune -f

# ============================================================================
# SECURITY
# ============================================================================

# Run security audit
security-audit:
    @echo "Running security audit..."
    cargo audit

# Check for outdated dependencies
deps-outdated:
    cargo outdated

# Update dependencies
deps-update:
    cargo update

# ============================================================================
# CI/CD
# ============================================================================

# Run full CI pipeline locally
ci: fmt-check lint test
    @echo "✅ CI pipeline passed"

# Pre-commit checks
pre-commit: fmt lint test
    @echo "✅ Pre-commit checks passed"

# Install git hooks
install-hooks:
    @echo "Installing git hooks..."
    echo '#!/bin/sh\njust pre-commit' > .git/hooks/pre-commit
    chmod +x .git/hooks/pre-commit
    @echo "✅ Git hooks installed"

# ============================================================================
# RSR COMPLIANCE
# ============================================================================

# Verify RSR anti-pattern compliance
rsr-check:
    @echo "Checking RSR compliance..."
    @echo "Checking for TypeScript..."
    @! find . -name "*.ts" -o -name "*.tsx" 2>/dev/null | grep -v node_modules | grep -q . || \
        (echo "❌ TypeScript files detected"; exit 1)
    @echo "✅ No TypeScript"
    @echo "Checking for Go..."
    @! find . -name "*.go" 2>/dev/null | grep -q . || \
        (echo "❌ Go files detected"; exit 1)
    @echo "✅ No Go"
    @echo "Checking for Makefile..."
    @! find . -name "Makefile" -o -name "*.mk" 2>/dev/null | grep -q . || \
        (echo "❌ Makefile detected"; exit 1)
    @echo "✅ No Makefile"
    @echo "Checking for npm lockfiles..."
    @test ! -f "package-lock.json" || (echo "❌ package-lock.json detected"; exit 1)
    @test ! -f "yarn.lock" || (echo "❌ yarn.lock detected"; exit 1)
    @echo "✅ No npm lockfiles"
    @echo ""
    @echo "╔══════════════════════════════════════════════════════════════╗"
    @echo "║            RSR Compliance Check Passed ✅                    ║"
    @echo "╚══════════════════════════════════════════════════════════════╝"

# ============================================================================
# RELEASE
# ============================================================================

# Prepare release
release-prep: clean ci docs security-audit
    @echo "✅ Release preparation complete"

# Create release
release VERSION:
    @echo "Creating release {{ VERSION }}..."
    git tag -a v{{ VERSION }} -m "Release {{ VERSION }}"
    @just build-release
    @echo "Release v{{ VERSION }} ready"

# ============================================================================
# UTILITIES
# ============================================================================

# Show project information
info:
    @echo "Project: {{ project }}"
    @echo "Version: {{ version }}"
    @echo ""
    @echo "Development Environment:"
    @echo "========================"
    @rustc --version 2>/dev/null || echo "Rust: Not installed"
    @cargo --version 2>/dev/null || echo "Cargo: Not installed"
    @nickel --version 2>/dev/null || echo "Nickel: Not installed"
    @just --version 2>/dev/null || echo "Just: Not installed"
    @podman --version 2>/dev/null || echo "Podman: Not installed"

# Show project statistics
stats:
    @echo "Project Statistics:"
    @echo "==================="
    @echo "Rust files: $(find . -name '*.rs' | grep -v target | wc -l)"
    @echo "Nickel files: $(find . -name '*.ncl' | wc -l)"
    @echo "Shell scripts: $(find . -name '*.sh' | wc -l)"
    @echo "Documentation: $(find docs -name '*.adoc' -o -name '*.md' 2>/dev/null | wc -l)"

# Find TODO comments
todos:
    @echo "TODO items:"
    @rg -n "TODO|FIXME|XXX|HACK" --glob '*.rs' --glob '*.ncl' . 2>/dev/null || echo "No TODOs found"

# Install development tools
install-tools:
    @echo "Installing development tools..."
    cargo install cargo-watch cargo-audit cargo-outdated cargo-llvm-cov || true
    @echo "✅ Tools installed"
